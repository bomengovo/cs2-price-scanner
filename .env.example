CSFLOAT_API_KEY=
CSQAQ_API_TOKEN=
STEAMDT_API_KEY=

USD_CNY_RATE=7.2000

DOMESTIC_PROVIDER=csqaq
MOCK_MODE=false

CSFLOAT_LISTINGS_AUTH_REQUIRED=true
# CSFloat intentionally ignores HTTP_PROXY/HTTPS_PROXY/ALL_PROXY.  Set this only
# to one stable HTTP(S) proxy if CSFloat must use a proxy on this machine.
# Keep this node fixed: a rotating VPN/Clash node changes the public egress IP
# and triggers CSFloat's multi-IP protection (HTTP 429 "too many IPs").
CSFLOAT_PROXY=
CSFLOAT_MULTI_IP_COOLDOWN_MS=1800000
CSFLOAT_IP_CHECK_INTERVAL_MS=60000
CSFLOAT_PAUSE_ON_IP_CHANGE=true
CSQAQ_AUTO_BIND_IP=true
CSQAQ_BIND_COOLDOWN_MS=600000
STEAMDT_BATCH_INTERVAL_MS=60000
